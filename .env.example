# ---- Banco de dados ----
POSTGRES_USER=plataforma
POSTGRES_PASSWORD=plataforma
POSTGRES_DB=plataforma_juridica
DATABASE_URL=postgresql://plataforma:plataforma@db:5432/plataforma_juridica

# ---- Backend ----
PORT=4000
JWT_SECRET=troque-esta-chave-em-producao
JWT_EXPIRES_IN=8h
CLIENT_PORTAL_JWT_SECRET=troque-esta-outra-chave-em-producao
FRONTEND_URL=http://localhost:5173
STORAGE_PATH=./storage/documents

# IA — deixe em branco para manter o módulo como "não configurado"
AI_API_KEY=

# ---- Frontend ----
VITE_API_URL=http://localhost:4000/api
